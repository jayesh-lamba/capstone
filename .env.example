# ==============================================================================
# FlyRank Embeddable Widget & Lead-Capture Platform - Environment Configuration
# ==============================================================================
# NOTE: Copy this file to .env before starting the application:
#   cp .env.example .env
# Never commit .env with real credentials to source control!

# ------------------------------------------------------------------------------
# Server Environment
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL via Docker)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=flyrank_widgets
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:your_secure_postgres_password@localhost:5432/flyrank_widgets

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_signing_key_min_32_characters_long
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# CORS Allowed Origins
# Comma-separated list of origins allowed to submit or load configs
# Use * or explicit domains like http://localhost:5500 for testing
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ------------------------------------------------------------------------------
# Abuse Protection & Rate Limiting
# ------------------------------------------------------------------------------
# Window in milliseconds (e.g. 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000
# Max requests per IP across public submission endpoint within the window
RATE_LIMIT_MAX_REQUESTS_PER_IP=15
# Max requests per Widget ID across all IPs within the window
RATE_LIMIT_MAX_REQUESTS_PER_WIDGET=60
# Max request body size for JSON submissions (prevents memory exhaustion)
MAX_PAYLOAD_SIZE=10kb

# ------------------------------------------------------------------------------
# Geolocation Enrichment & Fallback Providers ($0 Stack)
# ------------------------------------------------------------------------------
# Provider A: ip-api.com (JSON endpoint, 45 requests/min free, HTTP)
GEO_PROVIDER_A_URL=http://ip-api.com/json/
# Provider B: ipapi.co (Fallback provider, ~1,000 requests/day free, HTTPS)
GEO_PROVIDER_B_URL=https://ipapi.co/
# Request timeout per geo lookup attempt in milliseconds
GEO_TIMEOUT_MS=1500

# Deterministic testing toggles for Evaluator Probe 4:
# Set to 'true' to simulate Provider failure deterministically
MOCK_GEO_PROVIDER_A_FAIL=false
MOCK_GEO_PROVIDER_B_FAIL=false

# ------------------------------------------------------------------------------
# Safe Side Effects: Email & Webhook Notifications
# ------------------------------------------------------------------------------
# Delivery mode: 'console' (prints to stdout) or 'smtp' (e.g. Mailpit mail catcher)
EMAIL_PROVIDER=console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@flyrank.local

# Webhook dispatch timeout in milliseconds
WEBHOOK_TIMEOUT_MS=2000

# Deterministic testing toggle for Evaluator Probe 5:
# Set to 'true' to force side effects to throw exceptions without breaking main submission flow
SIMULATE_SIDE_EFFECT_FAILURE=false
